# breakur — environment variables
#
# Copy this file to `.env`: `make run` sources it automatically and
# `docker compose up` reads it for variable substitution. Everything below is
# optional: the app has sensible defaults and only `AUTH_SESSION_SECRET` matters
# (and only in production) for keeping sessions valid across restarts.

## ---------------------------------------------------------------------------
## Core app
## ---------------------------------------------------------------------------

# Listen address port. Defaults to 8080.
PORT=8080

# Postgres connection string.
# Default (local dev DB from compose.yaml):
#   postgres://breakur:breakur@localhost:5432/breakur?sslmode=disable
DATABASE_URL=postgres://breakur:breakur@localhost:5432/breakur?sslmode=disable

# Session signing secret. MUST be set and stable across instances/restarts in
# production; if empty, a key is generated and persisted locally instead.
AUTH_SESSION_SECRET=

# Where the auto-generated session key is stored when AUTH_SESSION_SECRET is
# unset. Defaults to the OS user config directory, not the repo.
# AUTH_SESSION_KEY_FILE=/home/you/.config/breakur/session.key

# Gin mode: debug | release | test. `release` enables secure cookies and
# quieter logging. Defaults to debug when unset.
GIN_MODE=debug

## ---------------------------------------------------------------------------
## Third-party sign-in (OAuth)
##
## A provider is enabled only when BOTH its client ID and secret are set;
## otherwise it is missing from the login/signup buttons and its routes.
## Register these redirect (callback) URLs with the provider:
##   <OAUTH_BASE_URL>/auth/github/callback
##   <OAUTH_BASE_URL>/auth/google/callback
## OAuth state cookies are signed with AUTH_SESSION_SECRET.
## ---------------------------------------------------------------------------

# Public base URL used to build provider callback URLs. Defaults to
# http://localhost:$PORT (or :8080). Must be reachable by the user's browser.
OAUTH_BASE_URL=http://localhost:8080

# GitHub OAuth app credentials (https://github.com/settings/developers).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth client credentials (https://console.cloud.google.com/apis/credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

## ---------------------------------------------------------------------------
## Optional Redis cache (short-link redirects)
##
## Leave REDIS_ADDR unset to run PostgreSQL-only. Set it to enable caching;
## an unreachable Redis degrades to PostgreSQL, never to a 5xx.
## ---------------------------------------------------------------------------

# Redis host:port.
# REDIS_ADDR=localhost:6379

# Redis AUTH password (empty when Redis has none).
REDIS_PASSWORD=

# Redis logical database index.
REDIS_DB=0

# Sliding TTL for cached links (reset on every hit). Default: 1h.
LINK_CACHE_TTL=1h

# Fixed TTL for unknown-code negative entries. Default: 60s.
LINK_CACHE_NEGATIVE_TTL=60s

# Per-operation Redis timeout; cache errors fall back to PostgreSQL.
# Default: 100ms.
LINK_CACHE_TIMEOUT=100ms

## ---------------------------------------------------------------------------
## Tests
## ---------------------------------------------------------------------------

# Optional override for the database used by integration tests. Defaults to
# DATABASE_URL (or the local dev DSN).
# TEST_DATABASE_URL=postgres://breakur:breakur@localhost:5432/breakur?sslmode=disable

## ---------------------------------------------------------------------------
## Docker Compose only
##
## These build the service URLs and host ports in compose.yaml; the Go app
## never reads them directly.
## ---------------------------------------------------------------------------

POSTGRES_USER=breakur
POSTGRES_PASSWORD=breakur
POSTGRES_DB=breakur
POSTGRES_PORT=5432
REDIS_PORT=6379